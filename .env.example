# LiteLLM provider keys — copy this file to .env and fill real values.
# .env is gitignored; never commit real keys.
DEEPSEEK_API_KEY=sk-your-deepseek-key
GLM_API_KEY=your-glm-api-key
QWEN_API_KEY=sk-your-qwen-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ComfyUI 本地引擎 (宿主机开发模式; Docker 容器内由 compose 覆盖为 host.docker.internal)
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_SD15_CHECKPOINT=v1-5-pruned-emaonly.safetensors

# MiniMax H3 视频 (v2 API; 国际 api.minimax.io / 国内 api.minimaxi.com)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
